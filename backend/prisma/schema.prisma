
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  expenses Expense[]
  budgets  Budget[]

  @@map("users")
}



model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenses Expense[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Expense
// ---------------------------------------------------------------------------
// amount uses Decimal(12,2): supports values up to 9,999,999,999.99 — sufficient
// for personal expense tracking while avoiding floating-point imprecision.
//
// Referential actions:
//   userId      → Cascade: deleting a user removes all their expenses.
//   categoryId  → Restrict: a category cannot be deleted while expenses reference it.
//                 The service layer must reassign expenses to "Uncategorized" first.

model Expense {
  id            String        @id @default(uuid())
  title         String
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime
  paymentMethod PaymentMethod
  notes         String?
  userId        String
  categoryId    String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Composite index: most common query — a user's expenses ordered by date
  @@index([userId, date])
  // Composite index: filter a user's expenses by category
  @@index([userId, categoryId])
  // Composite index: filter a user's expenses by payment method
  @@index([userId, paymentMethod])
  // Index: filter all expenses for a category (admin dashboard / reassignment)
  @@index([categoryId])

  @@map("expenses")
}



model Budget {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(12, 2)
  month     DateTime
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforce one budget per user per month at the database level
  @@unique([userId, month])
  // Index: retrieve a user's budgets sorted/filtered by month
  @@index([userId, month])

  @@map("budgets")
}
